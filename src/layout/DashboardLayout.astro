---
import '../styles/global.css';

interface Props {
  title?: string;
  userRole?: string;
}

const { title = 'Dashboard | IEP Gethsemani', userRole = 'Estudiante' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-100 text-slate-800 min-h-screen flex">

    <!-- Sidebar -->
    <aside class="w-64 bg-[#031530] text-white flex flex-col justify-between hidden md:flex shrink-0 min-h-screen">
      <div>
        <!-- Logo -->
        <div class="p-6 border-b border-white/10 flex items-center gap-3">
          <div class="w-8 h-8 bg-white rounded-md p-1 flex items-center justify-center">
            <img src="/logo-gethsemani.png" alt="Logo" class="w-full h-full object-contain" />
          </div>
          <div>
            <span class="font-extrabold text-sm tracking-wider block text-white leading-none">GETHSEMANI</span>
            <span class="text-[9px] text-yellow-400 font-bold uppercase">INTRANET</span>
          </div>
        </div>

        <!-- Menú Lateral adaptado a /app -->
        <nav class="p-4 space-y-1 text-xs font-semibold">
          <a href="/app" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/10 text-white">
            <span>📊</span> Panel Principal
          </a>
          <a href="/app/curso" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/5 transition">
            <span>📚</span> Mis Cursos / Notas
          </a>
          <a href="/app/asistencia" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/5 transition">
            <span>📅</span> Asistencia
          </a>
          <a href="/app/comunicado" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/5 transition">
            <span>📢</span> Comunicados
          </a>
        </nav>
      </div>

      <!-- Perfil y Salida -->
      <div class="p-4 border-t border-white/10 space-y-3">
        <div class="flex items-center gap-3 px-2">
          <div class="w-9 h-9 rounded-full bg-yellow-400 text-[#031530] font-black flex items-center justify-center text-xs">
            E
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-bold text-white truncate">Usuario Demo</p>
            <p class="text-[10px] text-gray-400 truncate">{userRole}</p>
          </div>
        </div>
        <a href="/" class="block w-full text-center py-2 rounded-lg bg-red-500/20 hover:bg-red-500/30 text-red-300 text-xs font-bold transition">
          Cerrar Sesión
        </a>
      </div>
    </aside>

    <!-- Área Principal de Contenido -->
    <div class="flex-1 flex flex-col min-w-0">
      <header class="bg-white border-b border-gray-200 h-16 px-6 flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-800">Panel del Estudiante</h2>
        <a href="/" class="text-xs font-semibold text-blue-600 hover:underline">Ir a la web principal &rarr;</a>
      </header>

      <main class="p-6 sm:p-8 flex-1 overflow-y-auto">
        <slot />
      </main>
    </div>

  </body>
</html>