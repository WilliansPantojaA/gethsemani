---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'IEP Gethsemani' } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Nuestra Historia', href: '/historia' },
  { name: 'Nuestra Identidad', href: '/identidad' },
  { name: 'Propuesta Educativa', href: '/propuesta' },
  { name: 'Plana Docente', href: '/docente' },
  { name: 'Admisión', href: '/admision' },
  { name: 'Ubicación', href: '/ubicacion' },
];
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-gradient-to-b from-[#091E3A] via-[#0A2B56] to-[#091E3A] text-white min-h-screen flex flex-col font-sans antialiased">
    
    <!-- Navbar con el tono Azul Medio exacto -->
    <header class="w-full bg-[#091E3A]/90 backdrop-blur-md sticky top-0 z-50 border-b border-sky-500/20 shadow-lg">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        
        <!-- Logo Institucional -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-11 h-11 bg-white rounded-xl p-1 flex items-center justify-center shadow-md">
            <img src="/logo-gethsemani.png" alt="Logo Gethsemani" class="w-full h-full object-contain" />
          </div>
          <div>
            <span class="font-extrabold text-lg tracking-wider block text-white leading-none">GETHSEMANI</span>
            <span class="text-[10px] text-sky-200 font-medium">Institución Educativa Particular</span>
          </div>
        </a>

        <!-- Menú de Navegación (Desktop) -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
          {navLinks.map((link) => (
            <a 
              href={link.href} 
              class={currentPath === link.href ? 'text-yellow-400 font-bold border-b-2 border-yellow-400 pb-1' : 'text-slate-200 hover:text-white transition'}
            >
              {link.name}
            </a>
          ))}
          <!--<a 
            href="/login" 
            class="ml-2 px-6 py-2.5 rounded-full bg-yellow-400 hover:bg-yellow-300 text-slate-950 transition duration-300 font-extrabold text-xs tracking-wider uppercase flex items-center gap-2 shadow-lg shadow-yellow-500/10"
          >
            Intranet &rarr;
          </a>-->
        </nav>

        <!-- Botón Hamburguesa (Móvil) -->
        <button 
          id="menuBtn" 
          type="button" 
          aria-label="Abrir menú" 
          class="md:hidden p-2 rounded-lg text-slate-200 hover:text-white hover:bg-sky-900/40 focus:outline-none transition"
        >
          <svg id="iconOpen" class="w-7 h-7 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="iconClose" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

      </div>

      <!-- Menú Desplegable (Móvil) -->
      <div id="mobileMenu" class="hidden md:hidden bg-[#091E3A] border-b border-sky-500/20 px-6 pt-3 pb-6 space-y-3">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class={currentPath === link.href ? 'block text-yellow-400 font-bold py-2' : 'block text-slate-200 hover:text-white py-2 transition'}
          >
            {link.name}
          </a>
        ))}
        <!--<div class="pt-2">
          <a 
            href="/login" 
            class="block w-full text-center py-3 rounded-full bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-extrabold text-xs tracking-wider uppercase transition shadow-lg shadow-yellow-500/10"
          >
            Intranet &rarr;
          </a>
        </div>-->
      </div>
    </header>

    <!-- Contenido dinámico de las vistas -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer Global -->
    <footer class="bg-[#051326] border-t border-sky-500/20 py-8 px-6 text-xs text-sky-200/70">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-white rounded-lg p-1 flex items-center justify-center">
            <img src="/logo-gethsemani.png" alt="Logo" class="w-full h-full object-contain" />
          </div>
          <div>
            <p class="font-bold text-white text-sm">GETHSEMANI</p>
            <p class="text-[11px] text-sky-300">Puerto Sira · Huánuco</p>
          </div>
        </div>
        <p class="text-center md:text-left">Formando con valores morales y disciplina para el futuro de la comunidad.</p>
        <p class="text-white font-medium">© IEP Gethsemani</p>
      </div>
    </footer>

    <!-- Script para interacción del menú hamburguesa -->
    <script>
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      const iconOpen = document.getElementById('iconOpen');
      const iconClose = document.getElementById('iconClose');

      if (menuBtn && mobileMenu && iconOpen && iconClose) {
        menuBtn.addEventListener('click', () => {
          const isHidden = mobileMenu.classList.toggle('hidden');
          iconOpen.classList.toggle('hidden', !isHidden);
          iconClose.classList.toggle('hidden', isHidden);
        });
      }
    </script>
  </body>
</html>