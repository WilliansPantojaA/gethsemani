---
import PublicLayout from '../layout/PublicLayout.astro';
---

<PublicLayout title="Acceso Intranet | IEP Gethsemani">
  <section class="min-h-[calc(100vh-80px)] flex items-center justify-center px-6 py-12 bg-gradient-to-br from-[#031530] via-[#05234e] to-[#020d20]">
    <div class="w-full max-w-md bg-white rounded-3xl p-8 sm:p-10 shadow-2xl text-slate-900 border-t-8 border-yellow-400 space-y-6">
      
      <!-- Cabecera -->
      <div class="text-center space-y-2">
        <div class="w-16 h-16 bg-[#031530] rounded-2xl p-2 mx-auto flex items-center justify-center shadow-md">
          <img src="/logo-gethsemani.png" alt="Logo IEP Gethsemani" class="w-full h-full object-contain" />
        </div>
        <h1 class="text-2xl font-extrabold text-[#031530] tracking-tight">Portal Intranet</h1>
        <p class="text-xs text-gray-500">Ingresa tus credenciales para acceder al sistema</p>
      </div>

      <!-- Alerta de Error -->
      <div id="error-alert" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs font-semibold text-center">
      </div>

      <!-- Formulario de Login -->
      <form id="loginForm" class="space-y-4">
        <div>
          <label for="dni" class="block text-xs font-bold uppercase text-gray-700 mb-1">DNI del Estudiante / Usuario</label>
          <input 
            type="text" 
            id="dni" 
            name="dni" 
            placeholder="87654321"
            maxlength="8"
            inputmode="numeric"
            pattern="[0-9]{8}"
            required 
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-[#031530] focus:border-transparent outline-none transition text-sm bg-gray-50"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-bold uppercase text-gray-700 mb-1">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            placeholder="••••••••"
            required 
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-[#031530] focus:border-transparent outline-none transition text-sm bg-gray-50"
          />
        </div>

        <button 
          type="submit" 
          id="btnSubmit"
          class="w-full py-3.5 bg-[#031530] hover:bg-[#05234e] text-white font-bold rounded-xl transition shadow-lg shadow-blue-900/20 text-sm tracking-wider uppercase mt-2 flex items-center justify-center gap-2"
        >
          <span>Iniciar Sesión</span>
        </button>
      </form>

      <div class="border-t border-gray-100 pt-4 text-center">
        <p class="text-[11px] text-gray-400">
          I.E.P. Gethsemani · Puerto Sira
        </p>
      </div>

    </div>
  </section>
</PublicLayout>

<script>
  import { createBrowserClient } from '@supabase/ssr';

  const supabase = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const alertBox = document.getElementById('error-alert') as HTMLDivElement;
  const btnSubmit = document.getElementById('btnSubmit') as HTMLButtonElement;
  const dniInput = document.getElementById('dni') as HTMLInputElement;

  // Bloquear tipeo de caracteres que no sean dígitos en tiempo real
  if (dniInput) {
    dniInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      target.value = target.value.replace(/\D/g, '').slice(0, 8);
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const dniVal = dniInput.value.trim();
      const passwordInput = (document.getElementById('password') as HTMLInputElement).value.trim();

      // Validación estricta: debe tener exactamente 8 dígitos
      const dniRegex = /^\d{8}$/;
      if (!dniRegex.test(dniVal)) {
        if (alertBox) {
          alertBox.innerText = 'El DNI debe tener exactamente 8 dígitos numéricos.';
          alertBox.classList.remove('hidden');
        }
        return;
      }

      // UI: Estado de carga
      if (alertBox) alertBox.classList.add('hidden');
      if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.innerText = 'Verificando...';
      }

      const emailFormatted = `${dniVal}@gmail.com`;

      try {
        const { error } = await supabase.auth.signInWithPassword({
          email: emailFormatted,
          password: passwordInput,
        });

        if (error) {
          if (alertBox) {
            alertBox.innerText = 'Credenciales incorrectas o usuario no registrado.';
            alertBox.classList.remove('hidden');
          }
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerText = 'Iniciar Sesión';
          }
        } else {
          window.location.assign('/app');
        }
      } catch (err) {
        if (alertBox) {
          alertBox.innerText = 'Error de conexión con el servidor de autenticación.';
          alertBox.classList.remove('hidden');
        }
        if (btnSubmit) {
          btnSubmit.disabled = false;
          btnSubmit.innerText = 'Iniciar Sesión';
        }
      }
    });
  }
</script>