---
import PublicLayout from '../layout/PublicLayout.astro';
---

<PublicLayout title="IEP Gethsemani | Inicio">
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-2 gap-12 items-center">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 text-sky-400 text-xs font-semibold uppercase tracking-wider">
        <span>✦</span> EDUCACIÓN QUE TRANSFORMA
      </div>
      
      <h1 class="text-4xl md:text-6xl font-black leading-tight tracking-tight">
        Aprender hoy. <br />
        <span class="text-yellow-400">Crecer para siempre.</span>
      </h1>
      
      <p class="text-gray-300 text-base md:text-lg leading-relaxed max-w-lg">
        Acompañamos a nuestros estudiantes de Primaria y Secundaria con una educación cercana, integral y comprometida con los valores y el futuro de Puerto Sira.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a 
          href="/propuesta" 
          class="px-8 py-3.5 rounded-full bg-yellow-400 text-[#031530] hover:bg-yellow-300 font-extrabold text-sm transition duration-300 shadow-lg shadow-yellow-500/10"
        >
          Conoce nuestra propuesta
        </a>
        <a 
          href="https://wa.me/51925363317"
          target="_blank" 
          class="px-6 py-3.5 rounded-full border border-white/20 hover:bg-white/10 text-white font-semibold text-sm transition duration-300"
        >
          Contactar por WhatsApp
        </a>
      </div>
    </div>

    <!-- Contenedor del Escudo / Foto de Portada -->
    <div class="relative flex justify-center items-center">
      <div class="w-full max-w-md aspect-square rounded-3xl bg-slate-900/60 border border-white/10 p-8 flex flex-col items-center justify-center relative overflow-hidden group shadow-2xl">
        <div class="absolute inset-0 bg-blue-600/10 blur-3xl rounded-full"></div>
        <img 
          src="/logo-gethsemani.png" 
          alt="Insignia IEP Gethsemani" 
          class="w-64 h-64 object-contain relative z-10 transition transform group-hover:scale-105 duration-300" 
        />
        <div class="mt-6 text-center relative z-10">
          <p class="text-xs font-bold tracking-widest uppercase text-gray-400">PUERTO SIRA</p>
          <p class="text-xs text-yellow-400 font-semibold mt-1">PRIMARIA • SECUNDARIA</p>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>