---
import DashboardLayout from '../../layout/DashboardLayout.astro';

const registros = [
  { fecha: '11/09/2026', estado: 'Presente', hora: '07:45 AM', observacion: 'Puntual' },
  { fecha: '10/09/2026', estado: 'Presente', hora: '07:50 AM', observacion: 'Puntual' },
  { fecha: '09/09/2026', estado: 'Tardanza', hora: '08:10 AM', observacion: 'Justificado por transporte' },
  { fecha: '08/09/2026', estado: 'Presente', hora: '07:42 AM', observacion: 'Puntual' },
  { fecha: '07/09/2026', estado: 'Presente', hora: '07:48 AM', observacion: 'Puntual' },
];
---

<DashboardLayout title="Asistencia | Intranet Gethsemani">
  <div class="space-y-6 max-w-6xl mx-auto">
    
    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-1">
      <h1 class="text-xl font-extrabold text-slate-900">Control de Asistencia</h1>
      <p class="text-xs text-gray-500">Historial de asistencia del estudiante en el aula</p>
    </div>

    <!-- Tabla de Registro -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-gray-50 border-b border-gray-200 text-gray-600 font-bold uppercase tracking-wider">
            <tr>
              <th class="p-4">Fecha</th>
              <th class="p-4">Hora de Ingreso</th>
              <th class="p-4">Estado</th>
              <th class="p-4">Observación</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 font-medium text-gray-700">
            {registros.map((item) => (
              <tr class="hover:bg-gray-50/50">
                <td class="p-4 font-bold text-slate-900">{item.fecha}</td>
                <td class="p-4">{item.hora}</td>
                <td class="p-4">
                  <span class={`px-2.5 py-1 rounded-md text-[11px] font-bold ${
                    item.estado === 'Presente' 
                      ? 'bg-emerald-100 text-emerald-800' 
                      : 'bg-amber-100 text-amber-800'
                  }`}>
                    {item.estado}
                  </span>
                </td>
                <td class="p-4 text-gray-500">{item.observacion}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</DashboardLayout>