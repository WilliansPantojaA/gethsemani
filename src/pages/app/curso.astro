---
import DashboardLayout from '../../layout/DashboardLayout.astro';

// Datos de ejemplo para la lista de cursos
const cursos = [
  { id: 1, nombre: 'Matemática', docente: 'Prof. Carlos Ramírez', promedio: 18, estado: 'Aprobado' },
  { id: 2, nombre: 'Comunicación', docente: 'Prof. Ana Mendoza', promedio: 17, estado: 'Aprobado' },
  { id: 3, nombre: 'Ciencia y Tecnología', docente: 'Prof. Jorge Quispe', promedio: 16, estado: 'Aprobado' },
  { id: 4, nombre: 'Personal Social', docente: 'Prof. Lucía Flores', promedio: 19, estado: 'Aprobado' },
  { id: 5, nombre: 'Educación Religiosa y Moral', docente: 'Prof. Ezequiel Ataucusi', promedio: 20, estado: 'Aprobado' },
  { id: 6, nombre: 'Inglés', docente: 'Prof. David Torres', promedio: 15, estado: 'Aprobado' },
];
---

<DashboardLayout title="Mis Cursos | Intranet Gethsemani">
  <div class="space-y-6 max-w-6xl mx-auto">
    
    <!-- Encabezado de Sección -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
      <div>
        <h1 class="text-xl font-extrabold text-slate-900">Mis Cursos y Calificaciones</h1>
        <p class="text-xs text-gray-500">Resumen académico del Bimensual I - Año Lectivo 2026</p>
      </div>
      <span class="px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-xs font-bold w-fit">
        Periodo Activo: Bimestre I
      </span>
    </div>

    <!-- Tabla / Tarjetas de Cursos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cursos.map((curso) => (
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between space-y-4 hover:border-blue-300 transition">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md">
                Secundaria
              </span>
              <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md">
                {curso.estado}
              </span>
            </div>
            <h2 class="text-lg font-bold text-slate-900">{curso.nombre}</h2>
            <p class="text-xs text-gray-500">{curso.docente}</p>
          </div>

          <div class="border-t border-gray-100 pt-4 flex items-center justify-between">
            <span class="text-xs font-bold text-gray-400 uppercase">Promedio</span>
            <span class="text-2xl font-black text-slate-900">{curso.promedio}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</DashboardLayout>