---
import DashboardLayout from '../../layout/DashboardLayout.astro';

const comunicados = [
  {
    id: 1,
    titulo: 'Reunión General de Padres de Familia',
    fecha: '10 de Septiembre, 2026',
    categoria: 'Institucional',
    contenido: 'Se convoca a todos los padres de familia de la I.E.P. Gethsemani a la asamblea informativa sobre el avance académico y proyectos de ecoeficiencia.'
  },
  {
    id: 2,
    titulo: 'Jornada de Limpieza y Reforestación Escolar',
    fecha: '05 de Septiembre, 2026',
    categoria: 'Medio Ambiente',
    contenido: 'Con la finalidad de promover el cuidado de nuestro entorno en Puerto Sira, realizaremos una jornada participativa con estudiantes de nivel secundaria.'
  }
];
---

<DashboardLayout title="Comunicados | Intranet Gethsemani">
  <div class="space-y-6 max-w-4xl mx-auto">
    
    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-1">
      <h1 class="text-xl font-extrabold text-slate-900">Boletín de Comunicados</h1>
      <p class="text-xs text-gray-500">Avisos y circulares oficiales de la Dirección Académica</p>
    </div>

    <div class="space-y-4">
      {comunicados.map((item) => (
        <article class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-800 font-bold">
              {item.categoria}
            </span>
            <span class="text-gray-400">{item.fecha}</span>
          </div>
          <h2 class="text-lg font-bold text-slate-900">{item.titulo}</h2>
          <p class="text-xs text-gray-600 leading-relaxed">{item.contenido}</p>
        </article>
      ))}
    </div>

  </div>
</DashboardLayout>