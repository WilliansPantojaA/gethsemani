---
import PublicLayout from '../layout/PublicLayout.astro';

const valores = [
  { nombre: "Respeto", color: "text-sky-400" },
  { nombre: "Responsabilidad", color: "text-yellow-400" },
  { nombre: "Honestidad", color: "text-emerald-400" },
  { nombre: "Empatía", color: "text-rose-400" },
  { nombre: "Creatividad", color: "text-purple-400" },
  { nombre: "Conciencia ambiental", color: "text-green-400" }
];
---

<PublicLayout title="Nuestra Identidad | IEP Gethsemani">
  <section class="max-w-7xl mx-auto px-6 py-16 space-y-16">
    
    <!-- Bloque Misión y Visión -->
    <div class="grid md:grid-cols-12 gap-8 items-stretch">
      <div class="md:col-span-5 space-y-5">
        <div class="inline-flex items-center gap-2 text-sky-400 text-xs font-bold uppercase tracking-widest">
          <span>✦</span> NUESTRA IDENTIDAD
        </div>
        <h1 class="text-4xl md:text-5xl font-black leading-tight text-white">
          Educamos desde nuestra realidad para llegar más lejos.
        </h1>
        <p class="text-sky-100/80 text-base leading-relaxed">
          Somos una institución de Puerto Sira que reconoce la riqueza de su comunidad y acompaña a cada estudiante en una formación integral[cite: 1].
        </p>
        <div class="flex gap-3 pt-2">
          <span class="px-5 py-2 rounded-full bg-sky-500/10 border border-sky-400/30 text-xs font-semibold text-sky-200">PRIMARIA</span>
          <span class="px-5 py-2 rounded-full bg-sky-500/10 border border-sky-400/30 text-xs font-semibold text-sky-200">SECUNDARIA</span>
        </div>
      </div>

      <div class="md:col-span-7 grid gap-6">
        <!-- Tarjeta Visión Amarillo Intenso -->
        <div class="bg-gradient-to-br from-yellow-400 to-yellow-500 text-slate-950 p-8 md:p-10 rounded-3xl shadow-xl shadow-yellow-500/10 transition transform hover:-translate-y-1 duration-300">
          <span class="text-[11px] font-extrabold uppercase tracking-widest block mb-2 opacity-80">NUESTRA VISIÓN</span>
          <h2 class="text-3xl font-black mb-3">Líderes para una vida mejor</h2>
          <p class="text-sm md:text-base font-semibold leading-relaxed opacity-90">
            Ser una institución ecoeficiente, generadora de buenas prácticas ambientales y formadora de ciudadanos autónomos, líderes y comprometidos con el desarrollo sostenible[cite: 1].
          </p>
        </div>

        <!-- Tarjeta Misión Blanco Destacado -->
        <div class="bg-white text-slate-900 p-8 md:p-10 rounded-3xl shadow-xl transition transform hover:-translate-y-1 duration-300">
          <span class="text-[11px] font-extrabold uppercase tracking-widest block mb-2 text-sky-600">NUESTRA MISIÓN</span>
          <h2 class="text-3xl font-black mb-3">Educación de calidad, cercana e integral</h2>
          <p class="text-sm md:text-base font-medium leading-relaxed text-slate-700">
            Brindar un servicio educativo que fortalezca la identidad, respete la diversidad y promueva competencias, bienestar y una convivencia basada en la paz y los valores[cite: 1].
          </p>
        </div>
      </div>
    </div>

    <!-- Bloque Valores -->
    <div class="pt-8 border-t border-sky-500/20">
      <div class="mb-8">
        <span class="text-sky-400 text-xs font-bold uppercase tracking-widest block mb-1">── LO QUE NOS GUÍA</span>
        <h2 class="text-3xl font-black text-white">Valores que dejan huella.</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        {valores.map((valor) => (
          <div class="bg-[#0B3A6F]/60 border border-sky-400/20 p-5 rounded-2xl flex items-center gap-4 hover:border-sky-400/50 transition duration-300">
            <div class="w-10 h-10 rounded-xl bg-slate-900/60 flex items-center justify-center font-bold text-lg border border-white/5">
              <span class={valor.color}>✓</span>
            </div>
            <span class="font-bold text-base text-white">{valor.nombre}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</PublicLayout>